# Copiá este archivo a ".env.local" y completá tu clave de la API de Ticketmaster.
# Se consigue gratis en https://developer.ticketmaster.com/
# ".env.local" nunca se sube al repositorio (ver .gitignore).
#
# IMPORTANTE: esta variable NO lleva el prefijo VITE_ a propósito. Vite solo
# expone al navegador las variables que empiezan con VITE_; como esta clave
# solo la usa la función serverless (api/eventos.js) del lado del servidor,
# tiene que quedar afuera de ese prefijo para que nunca termine en el bundle
# que se descarga el navegador.
TM_API_KEY=
